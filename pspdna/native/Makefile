	$(MAKE) $(MAKESILENT) -f CMakeFiles/pspdna.dir/build.make CMakeFiles/pspdna.dir/dna.c.obj
.PHONY : dna.c.obj

dna.i: dna.c.i
.PHONY : dna.i

